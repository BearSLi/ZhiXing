# ============================================================
#  环境变量模板
#  用法：复制为 .env 后填入真实值（.env 已被 .gitignore / .dockerignore 排除）
#    Windows:  Copy-Item .env.example .env
#    Linux/WSL: cp .env.example .env
# ============================================================

# ── 应用密钥：用于签发/验证 JWT ──
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️ 绝不能用默认值上线，也绝不能提交到 git
SECRET_KEY=请替换为随机生成的64位十六进制字符串

# Token 有效期（小时）
# TOKEN_EXPIRE_HOURS=12

# ── 大模型配置（OpenAI 兼容接口，换供应商只改这三行）──
# DeepSeek:  https://api.deepseek.com          deepseek-chat
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4   glm-4-flash
# Kimi:      https://api.moonshot.cn/v1        moonshot-v1-8k
LLM_API_KEY=sk-请填入你的APIKey
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── 数据库路径 ──
# 本地开发：留空即用默认的 app.db（与代码同目录）
# 容器运行：不要写在这里，用 docker run -e DB_PATH=/app/data/app.db 注入
# 原因：.env 是本地与容器共用的，写死容器路径会导致本地开发崩掉
# DB_PATH=app.db
